{
  "name": "@local/dsh-appearance-boot",
  "version": "2.1.1",
  "private": true,
  "type": "module",
  "engines": {
    "dsh": ">=0.2.2-rc.2 <0.3.0"
  },
  "description": "Appearance & Boot: a home for interface skins and boot animations. One Settings page holds independent chapters for each, with switches and live previews.",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "build.mjs",
    "src/**",
    "cordis.patch.yml",
    "boot/*.html",
    "locale/*.json",
    "icon.svg",
    "THIRD-PARTY-NOTICES.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-theme"
      ]
    }
  }
}
